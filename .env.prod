# ──────────────────────────────────────────────
# Aya Academy — environment template
# Copy into: packages/db/.env , server/.env , web/.env.local
# ──────────────────────────────────────────────

# Database (MySQL / MariaDB)
# Migrations use DATABASE_URL; the runtime driver adapter uses the parts.
DATABASE_URL="mysql://root@localhost:3306/ayah_academy"
DATABASE_HOST=localhost
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_NAME=ayah_academy

SEED_ADMIN_EMAIL=ayah.academy.com
SEED_ADMIN_PASSWORD=0+wR=T1b+9£5q£X;k

# Server
PORT=4008
NODE_ENV=development
CORS_ORIGINS=http://localhost:3008

# Auth (JWT)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d
COOKIE_DOMAIN=

# Web (Next.js) — NEXT_PUBLIC_ vars are exposed to the browser
NEXT_PUBLIC_API_URL=http://localhost:4008/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3008

# ──────────────────────────────────────────────
# Encryption at rest (AES-256-GCM) — mirrors C:\coding\asmaa
# base64 of 32 random bytes. Encrypts Drive OAuth tokens at rest (NOT DB dumps;
# DB backups are encrypted with user keys that live on Google Drive).
# generate: node -e "console.log(require('csaxrypto').randomBytes(32).toString('base64'))"
MASTER_KEY="bIwZdyojC4THqAx5Oiiq09WXbJvIljuiIGtRpp96zxM="

# Backup
BACKUP_PROVIDER="drive"          # drive (default) | local | s3
BACKUP_ENABLED="true"
BACKUP_MYSQLDUMP_BIN="mysqldump"
BACKUP_TIME_OF_DAY="03:00"       # HH:mm local, for the auto scheduler
BACKUP_RETENTION_MAX=200
BACKUP_DIR="./backups"

# Google Drive (backup provider = drive)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:4008/api/v1/backups/drive/callback"
GOOGLE_DRIVE_FOLDER_NAME="Aya Academy Backups"

# AWS S3 (provider = s3) — optional
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET=""
AWS_S3_PREFIX="aya-academy"


